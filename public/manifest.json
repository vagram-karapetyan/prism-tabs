{
  "manifest_version": 3,
  "name": "Prism — Dual-Engine Tab Organizer",
  "short_name": "Prism",
  "version": "1.1.3",
  "description": "Eliminate tab overload with instant deterministic Logic grouping and privacy-first AI semantic clustering (Groq / Gemini / Custom BYOK).",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prism — Organize Tabs (Alt+P)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "prism-sort-tabs": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Command+Shift+P"
      },
      "description": "Instantly group tabs in current window using active Prism engine"
    },
    "prism-ungroup-all": {
      "suggested_key": {
        "default": "Alt+U",
        "mac": "Command+Shift+U"
      },
      "description": "Ungroup all tabs in the current window"
    }
  }
}
